+
+<BuildLayout
+  title={title}
+  description={summary}
+  breadcrumbs={[
+    { name: 'Home', path: '/' },
+    { name: 'Building', path: '/building/' },
+    { name: title, path: '/building/example-recipe-card-maker/' },
